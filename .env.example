# .env.example - Copy to .env and fill in your actual values

# LLM Provider Configuration (Options: ollama, openai)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# OpenAI Credentials (required if using openai provider)
OPENAI_API_KEY=sk-proj-YOUR-KEY-HERE

# Ollama Configurations
OLLAMA_HOST=http://localhost:11434

# Token Management & History Compression
MAX_CONVERSATION_TOKENS=50000        # Threshold (tokens) for triggering compression
RECENT_TURNS_TO_KEEP=10              # Number of recent complete turns to preserve in context
COMPRESSION_ENABLED=true             # Enable/disable automatic history compression
EXTERNAL_MEMORY_DIR=./conversation_memory  # Directory for saving/loading sessions

# WebFetchTool Configuration
WEBFETCH_ENABLED=true                # Enable/disable HTTP requests from agent
WEBFETCH_MAX_RESPONSE_SIZE=102400    # Max bytes per response (100KB); larger responses truncated
WEBFETCH_DEFAULT_TIMEOUT=10          # Default timeout in seconds for HTTP requests
WEBFETCH_MAX_TIMEOUT=30              # Maximum allowed timeout (hard limit)
WEBFETCH_FOLLOW_REDIRECTS=true       # Follow HTTP redirects (max 5)
WEBFETCH_BLOCKLIST_INTERNAL_IPS=true # Block SSRF attempts (127.0.0.1, 192.168.*, etc.)
